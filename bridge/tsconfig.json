{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",                      // pinned; Bun runs it natively. TS7's default floats.
    "lib": ["es2024"],
    "types": ["bun"],                        // TS7 default is [] — must be explicit. Bun's types include Node's.
    "strict": true,                          // TS7 default, stated explicitly
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,      // `k?: T` means absent-or-T; an undefined value must be spelled `T | undefined`
    "noUncheckedIndexedAccess": true,        // `arr[i]` / `record[k]` are `T | undefined` until checked
    // Type-check only: Bun runs the TypeScript source directly, and the npm package ships src/ as it is
    // (package.json `bin` and `files`), so there is no build and nothing to emit.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,               // `import pkg from "../package.json" with { type: "json" }` (the version)
    "erasableSyntaxOnly": true,              // reject enum / namespace / param properties: Bun strips types, it does not compile them
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
