{
  "compilerOptions": {
    // The MCP SDK is ESM-only, so this file is ESM (built to figma-mcp.mjs). nodenext gives the
    // correct ESM resolution + requires the .js extension on SDK subpath imports.
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
