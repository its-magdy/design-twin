{
  "name": "@design-twin/dtwin",
  "version": "0.1.4",
  "description": "Figma → code with Claude Code: the dtwin CLI + MCP server (and the Figma plugin) that read a design on the free Figma plan into your project, fully offline.",
  "license": "MIT",
  "author": "Mohamed Magdy Omar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-magdy/design-twin.git",
    "directory": "bridge"
  },
  "homepage": "https://github.com/its-magdy/design-twin#readme",
  "bugs": "https://github.com/its-magdy/design-twin/issues",
  "keywords": [
    "figma",
    "figma-plugin",
    "figma-to-code",
    "design-to-code",
    "design-system",
    "design-tokens",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "bun",
    "cli"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "dtwin": "src/figma-pull.ts"
  },
  "files": [
    "src",
    "layer",
    "figma-plugin",
    "bun.lock",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepack": "bun --no-install --no-env-file pack.ts",
    "postpack": "bun --no-install --no-env-file pack.ts --clean",
    "pull": "bun src/figma-pull.ts",
    "pull:selection": "bun src/figma-pull.ts --selection",
    "mcp": "bun src/figma-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
