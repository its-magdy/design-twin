{
  "name": "designtwin",
  "version": "0.1.0",
  "description": "Design Twin bridge: local CLI + MCP server between Claude Code and the Design Twin Figma plugin. Reads a design on the free Figma plan, fully offline.",
  "license": "MIT",
  "author": "Mohamed Magdy Omar",
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-to-code",
    "design-system",
    "design-tokens",
    "claude-code",
    "figma-plugin",
    "cli"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dtwin": "./figma-pull.js"
  },
  "files": [
    "figma-pull.js",
    "figma-mcp.mjs",
    "init.js",
    "daemon.js",
    "design-system-layout.js",
    "errmsg.js",
    "library-layout.js",
    "node-id.js",
    "pages-layout.js",
    "read-opts.js",
    "seed-components.js",
    "server-core.js",
    "snapshot-meta.js",
    "token-store.js",
    "write-out.js",
    "design-system-layout.d.ts",
    "errmsg.d.ts",
    "library-layout.d.ts",
    "node-id.d.ts",
    "pages-layout.d.ts",
    "read-opts.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pull": "node figma-pull.js",
    "pull:selection": "node figma-pull.js design --selection",
    "mcp": "node figma-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node build.js"
  },
  "dependencies": {
    "ws": "^8.21.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "@types/node": "^26.1.1"
  }
}
