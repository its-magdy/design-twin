{
  "name": "designtwin",
  "version": "0.1.0",
  "description": "Design Twin bridge: local CLI + MCP server between Claude Code and the Design Twin Figma plugin. Reads a design on the free Figma plan, fully offline.",
  "license": "MIT",
  "author": "Mohamed Magdy Omar",
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-to-code",
    "design-system",
    "design-tokens",
    "claude-code",
    "figma-plugin",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "bin": {
    "dtwin": "./dist/figma-pull.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "typecheck": "tsc --noEmit",
    "pull": "node src/figma-pull.ts",
    "pull:selection": "node src/figma-pull.ts design --selection",
    "mcp": "node src/figma-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
