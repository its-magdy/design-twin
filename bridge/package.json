{
  "name": "designtwin",
  "version": "0.1.0-alpha.0",
  "description": "Design Twin bridge: local CLI + MCP server between Claude Code and the Design Twin Figma plugin. Reads a design on the free Figma plan, fully offline.",
  "license": "MIT",
  "author": "Mohamed Magdy Omar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/its-magdy/design-twin.git",
    "directory": "bridge"
  },
  "homepage": "https://github.com/its-magdy/design-twin/tree/main/bridge#readme",
  "bugs": "https://github.com/its-magdy/design-twin/issues",
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-to-code",
    "design-system",
    "design-tokens",
    "claude-code",
    "figma-plugin",
    "cli"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "dtwin": "src/figma-pull.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pull": "bun src/figma-pull.ts",
    "pull:selection": "bun src/figma-pull.ts design --selection",
    "mcp": "bun src/figma-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
