{
  "compilerOptions": {
    // Figma's plugin main thread is a QuickJS-like realm: ES6 but NO browser/DOM globals.
    // "dom" is deliberately omitted — it would pull in DOM-typed console/fetch/timers that
    // conflict with the narrower ones @figma/plugin-typings declares (see index.d.ts).
    // The Figma sandbox baseline used by build.js (esbuild target es2019); matches "lib".
    "target": "es2019",
    "lib": ["es2019"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    // esbuild transpiles one file at a time; this flags type-only re-exports it can't see through.
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // Plugin API types are hosted under /@figma (not DefinitelyTyped's /@types). Load them via
    // `types` so bundler module resolution finds the scoped package — this makes the globals
    // (figma, __html__) available without imports AND works under the TS7 native compiler, which
    // no longer auto-includes packages found via `typeRoots`.
    "types": ["@figma/plugin-typings"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // The shared bridge modules are imported as ../../bridge/src/x.ts (esbuild inlines them; nothing
    // here emits), and erasableSyntaxOnly keeps them Node-strippable for the bridge's own runtime.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src", "figma-augment.d.ts"]
}
