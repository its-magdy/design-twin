# Dependencies
node_modules/

# Generated Figma exports (regenerable via the plugin / dtwin).
# NOTE: your hand-authored config maps are NOT regenerable — if you keep
# target.json / tokens.json / components.json in design/, un-ignore them.
design/

# Live-test scratch output
livetest-tmp/
out-selection/
out-full/
out-allpages/

# macOS
.DS_Store

# Local Claude Code settings. (The bridge token no longer lives here: it is stored per-user in
# ~/.config/design-twin/bridge-token — see bridge/README.md. FIGMA_BRIDGE_TOKEN still overrides it.)
.claude/settings.local.json

# The bridge's old tsc emit. It has none any more (Bun runs and ships bridge/src/*.ts as is); kept ignored so
# a dist/ left in an older checkout is never committed.
bridge/dist/
