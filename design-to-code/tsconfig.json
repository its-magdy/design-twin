{
  // Exists for oxlint's type-aware mode: tsgolint types each file by the NEAREST tsconfig, and without
  // this one every design-to-code file typed as `error`. test/tsconfig.json still type-checks these files.
  "extends": "../test/tsconfig.json",
  // `k?: T` means absent-or-T; an undefined value must be spelled `T | undefined` (as in bridge/tsconfig.json)
  // `arr[i]` / `record[k]` are `T | undefined` (shipped code only — test/tsconfig.json does not set it)
  "compilerOptions": { "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true },
  "include": ["./**/*.ts"]
}
