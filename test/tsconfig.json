{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // Transitional: every module the tests import is TypeScript now; what remains is the tests' own
    // `any` (left over from when they imported untyped CommonJS). Dropped by the de-any pass.
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../design-to-code/**/*.ts", "../bridge/src/ws.d.ts"]
}
