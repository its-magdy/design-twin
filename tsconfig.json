{
  // The Node build scripts that sit beside non-Node code: figma-plugin/tsconfig.json types the plugin
  // sandbox (no Node), so it cannot own figma-plugin/build.ts. oxlint's type-aware mode falls back to
  // this ancestor config for a file its nearest tsconfig does not include, and `npm run typecheck`
  // checks it with `tsc -p tsconfig.json`.
  "extends": "./test/tsconfig.json",
  "include": ["figma-plugin/build.ts"]
}
