{
  // The build scripts (run by Bun) that no runtime-typed project owns: figma-plugin/tsconfig.json types
  // the plugin sandbox (no Bun/Node APIs), and claude-plugin/ has no tsconfig. oxlint's type-aware mode
  // falls back to this ancestor config for a file its nearest tsconfig does not include, and
  // `bun run typecheck` checks it with `tsc -p tsconfig.json`.
  "extends": "./test/tsconfig.json",
  "include": ["bridge/pack.ts", "bridge/release-bump.ts", "figma-plugin/build.ts", "figma-plugin/build-options.ts", "claude-plugin/build-scripts.ts"]
}
